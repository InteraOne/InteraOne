{
  "name": "InteraOne",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev:full": "pnpm run docker:start && turbo run dev --filter=!./apps/launcher",
    "dev": "turbo run dev --filter=!./apps/launcher",
    "docker:start": "cd docker && node ../scripts/compose.cjs -f docker-compose.dev.yml up -d redis mongodb mongo-express mailhog silo qdrant",
    "docker:stop": "cd docker && node ../scripts/compose.cjs -f docker-compose.dev.yml down",
    "widget:deploy": "cd apps/launcher && pnpm run deploy",
    "widget:deploy:prod": "cd apps/launcher && pnpm run deploy:prod",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@ompharate/better-context": "^1.0.0",
    "dodopayments": "^2.27.0",
    "zod": "^4.3.6"
  }
}
