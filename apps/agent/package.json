{
  "name": "@InteraOne/agent",
  "version": "1.0.0",
  "description": "InteraOne AI processing service — BullMQ worker + Redis Streams",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "reset:vectors": "npx tsx scripts/reset-vector-db.ts",
    "inspect:vectors": "npx tsx scripts/inspect-vector-db.ts",
    "debug:qdrant": "npx tsx src/debug-qdrant.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1067.0",
    "@google/genai": "^0.7.0",
    "@huggingface/inference": "^4.13.20",
    "@qdrant/js-client-rest": "1.17.0",
    "openai": "^4.52.0",
    "axios": "^1.13.5",
    "bullmq": "^5.0.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "ioredis": "^5.3.2",
    "mammoth": "^1.11.0",
    "minio": "^8.0.6",
    "p-limit": "^7.3.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.43.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}