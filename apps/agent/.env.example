# ── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev123

# ── Gateway API Connection ─────────────────────────
API_URL=http://localhost:3002/api/v1
AI_TOOL_SECRET=interaone_default_secret_2026
# Must exceed the gateway's Composio timeout plus request overhead.
INTERNAL_API_TIMEOUT_MS=20000

# ── Silo (Object Storage) ─────────────────────────
SILO_ENDPOINT=localhost
SILO_PORT=9001
SILO_USE_SSL=false
SILO_ACCESS_KEY=silo-admin
SILO_SECRET_KEY=silo-admin
SILO_BUCKET_NAME=interaone-dev

# ── Qdrant (Vector Database) ───────────────────────
QDRANT_URL=http://localhost:6333

# ── LLM Configuration ──────────────────────────────
LLM_PROVIDER=huggingface
HF_TOKEN=
HF_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct
# Timeout for each Hugging Face inference request. Multi-step workflows use
# multiple independently bounded requests and a separate total deadline.
HF_MAX_TIMEOUT_MS=60000
HF_WORKFLOW_TIMEOUT_MS=180000

# AWS Bedrock LLM Configuration
AWS_REGION=us-east-1
BEDROCK_MODEL=amazon.nova-pro-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Ollama LLM Configuration
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama4:scout

# OpenAI LLM Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# ── Embedding Configuration ────────────────────────
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
HF_EMBEDDING_DIMENSIONS=1024

# AWS Bedrock Embeddings Configuration
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Ollama Embeddings Configuration
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_EMBEDDING_DIMENSIONS=1024

# OpenAI Embeddings Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024

# ── RAG Settings ───────────────────────────────────
RAG_TOP_K=5
CHAT_HISTORY_LIMIT=6

# ── Workers ────────────────────────────────────────
WORKER_CONCURRENCY=5
INGESTION_CONCURRENCY=2

# ── Health Check Server ────────────────────────────
AI_HEALTH_PORT=4010

# Shared provider-neutral agent tool-loop bounds.
AGENT_MAX_TOOL_LOOPS=8
AGENT_MAX_TOOL_CALLS_PER_TURN=20
