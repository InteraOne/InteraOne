# ── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev123


# ── Database ───────────────────────────────────────
MONGODB_URI=mongodb://admin:dev123@localhost:27017/interaone-dev?authSource=admin


# ── Email ──────────────────────────────────────────
# Providers: mailhog (local SMTP dev server) | smtp | ses (AWS SES) | disabled
EMAIL_PROVIDER=mailhog
EMAIL_FROM_NAME=InteraOne
EMAIL_FROM_EMAIL=noreply@interaone.app

# Mailhog SMTP Configuration
EMAIL_HOST=localhost
EMAIL_PORT=1025

# Generic SMTP Configuration
# Required when EMAIL_PROVIDER=smtp. Authentication is optional, but SMTP_USER
# and SMTP_PASS must be provided together. Use an app password for Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for implicit TLS/SSL (normally port 465)
SMTP_SECURE=false
# true to require STARTTLS (normally port 587)
SMTP_REQUIRE_TLS=true


# ── AWS SES Configuration ──────────────────────────
# Required when EMAIL_PROVIDER=ses
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ── Worker Settings ────────────────────────────────
WORKER_CONCURRENCY=5

# ── Lead source ingestion ──────────────────────────
# Must match the gateway value used to encrypt provider credentials.
LEAD_SOURCE_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v26.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Forms does not send response webhooks, so the worker polls active forms.
GOOGLE_FORMS_POLL_INTERVAL_MS=60000
