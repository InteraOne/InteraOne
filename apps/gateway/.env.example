# ── App ────────────────────────────────────────────
NODE_ENV=development                        # development | production
PORT=3002
CLIENT_URL=http://localhost:5173            # URL of the console (frontend). Required in production.
PUBLIC_API_URL=http://localhost:3002        # Public-facing API URL used in webhooks (e.g. Telegram)
SERVICE_NAME=interaone-gateway              # Optional. Label used in structured logs.
LOG_LEVEL=debug                             # debug | info | warn | error. Defaults to debug in dev.
INTERAONE_MODE=self-host                    # self-host | cloud

# ── Dodo Payments ─────────────────────────────
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_PRODUCT_PRO=
DODO_PAYMENTS_PRODUCT_PROPLUS=
DODO_PAYMENTS_WEBHOOK_SECRET=


# ── Database ───────────────────────────────────────
MONGODB_URI=mongodb://admin:dev123@localhost:27017/interaone-dev?authSource=admin


# ── Redis ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev123


# ── JWT ────────────────────────────────────────────
JWT_SECRET=interaone-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=interaone-dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=30d


# ── Email ──────────────────────────────────────────
# Providers: mailhog (local SMTP dev server) | ses (AWS SES) | disabled
EMAIL_PROVIDER=mailhog
EMAIL_FROM_NAME=InteraOne Platform
EMAIL_FROM_EMAIL=noreply@interaone.app


# ── AWS (SES email + SNS webhooks) ─────────────────
# Required when EMAIL_PROVIDER=ses or when using the AWS SES channel.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ── Silo (Object Storage) ─────────────────────────
SILO_ENDPOINT=localhost
SILO_PORT=9001
SILO_USE_SSL=false
SILO_ACCESS_KEY=silo-admin
SILO_SECRET_KEY=silo-admin
SILO_BUCKET_NAME=interaone-dev

# Publicly accessible base URL for uploaded files (e.g. presigned URL host).
SILO_PUBLIC_URL=http://localhost:9001


# ── Rate Limiting ──────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000                 # Window in ms. Default: 900000 (15 min)
RATE_LIMIT_MAX_REQUESTS=10000              # Max requests per window. Default: 10000


# ── Internal Security ──────────────────────────────
# Shared secret between the gateway and agent services for AI tool authentication.
AI_TOOL_SECRET=interaone_default_secret_change_me_in_production

# ── Facebook Lead Ads ──────────────────────────────
# OAuth redirect URL:
#   ${PUBLIC_API_URL}/api/v1/lead-sources/facebook/callback
# Page webhook callback URL:
#   ${PUBLIC_API_URL}/api/v1/lead-sources/facebook/webhook
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v26.0
# pages_manage_metadata is required to subscribe Pages to the leadgen webhook.
META_OAUTH_SCOPES=leads_retrieval,pages_show_list,pages_read_engagement,pages_manage_ads,pages_manage_metadata

# AES-256-GCM key material for Page access tokens. Keep this value stable.
LEAD_SOURCE_ENCRYPTION_KEY=

# ── Google Forms ───────────────────────────────────
# OAuth callback: ${PUBLIC_API_URL}/api/v1/lead-sources/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_FORMS_REDIRECT_URI=
GOOGLE_FORMS_OAUTH_SCOPES=openid,email,https://www.googleapis.com/auth/drive.metadata.readonly,https://www.googleapis.com/auth/forms.body.readonly,https://www.googleapis.com/auth/forms.responses.readonly


# OAuth callback: ${PUBLIC_API_URL}/api/v1/lead-sources/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_OAUTH_SCOPES=openid,email,https://www.googleapis.com/auth/calendar.calendarlist.readonly,https://www.googleapis.com/auth/calendar.events


# OAuth callback: ${PUBLIC_API_URL}/api/v1/lead-sources/google-tasks/callback
GOOGLE_TASKS_REDIRECT_URI=
GOOGLE_TASKS_OAUTH_SCOPES=openid,email,https://www.googleapis.com/auth/tasks.readonly

ALLOWED_DOMAINS=
