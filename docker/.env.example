# ============================================================
# docker/.env.example  —  Docker Compose variable substitution
# ============================================================
# Copy this file to docker/.env and fill in your values.
#   cp docker/.env.example docker/.env
#
# Then edit docker/.env with real credentials and host names.
# docker/.env is .gitignored — never commit it.
# ============================================================

# Shared MongoDB credentials (used by MongoDB container + MONGODB_URI in services)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=dev123
MONGO_DATABASE=interaone

# Shared Redis password (used by Redis container + REDIS_PASSWORD in services)
REDIS_PASSWORD=dev123

# Silo credentials
SILO_ROOT_USER=silo-admin
SILO_ROOT_PASSWORD=silo-admin

# Public URL browsers use to reach Silo (presigned URLs / widget JS).
# Set this to the CDN subdomain below, e.g.:
#   https://cdn.example.com   (domain, Caddy issues TLS automatically)
#   http://1.2.3.4            (IP address, no TLS)
SILO_PUBLIC_URL=http://localhost

# ── Caddy reverse-proxy hosts ───────────────────────────────────────────────
# API_HOST  — domain/IP for the backend API and Socket.IO (port 80/443).
#             Caddy handles TLS automatically for real domain names.
#             With an IP address Caddy serves plain HTTP.
# WEB_HOST  — domain/IP for the Vite web frontend (port 80/443).
#             Set equal to API_HOST to use single-domain path routing
#             (/api/* and /socket.io/* -> API, everything else -> web).
# CDN_HOST  — subdomain for Silo file storage and widget JS delivery.
#             Caddy proxies this subdomain -> silo:9001 with auto-TLS.
# LOG_HOST  — subdomain for Dozzle log viewer.
#             Caddy proxies this subdomain -> log-viewer:8080 with auto-TLS.
#
# Examples:   API_HOST=api.example.com  WEB_HOST=api.example.com  CDN_HOST=cdn.example.com  LOG_HOST=logs.example.com
# IP / dev:   API_HOST=1.2.3.4          WEB_HOST=1.2.3.4           CDN_HOST=1.2.3.4          LOG_HOST=1.2.3.4
API_HOST=localhost
WEB_HOST=localhost
CDN_HOST=localhost
LOG_HOST=localhost

# The API URL baked into the widget JavaScript at build time.
# Should match the public URL where your API is accessible.
# Examples:
#   https://apiInteraOne.InteraOne.cloud  (production domain)
#   http://localhost:3002            (local development)
API_URL_PRODUCTION=http://localhost:3002

# ── Dozzle Log Viewer (Open Source Log Console) ────────────────────────────────
# Enable secure logs dashboard at http://localhost:LOG_VIEWER_PORT
LOG_VIEWER_PORT=8888
