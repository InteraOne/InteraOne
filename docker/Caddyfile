# ============================================================
# Caddyfile  —  InteraOne reverse proxy
#
# Uses Caddy's native environment variable substitution: {$VAR}
# Values come from docker/.env  →  docker-compose caddy.environment
#
# API_HOST  — domain/IP that serves the backend API and sockets
#             e.g.  api.example.com   or   1.2.3.4
# WEB_HOST  — domain/IP that serves the Vite frontend
#             e.g.  app.example.com   (can be the same as API_HOST)
# CDN_HOST  — subdomain for Silo (file storage / widget JS delivery)
#             e.g.  cdn.example.com
#
# TLS behaviour (automatic, zero-config):
#   - Real domain name  → Caddy obtains a Let's Encrypt cert automatically.
#   - IP address        → Caddy serves plain HTTP (no cert possible).
#   - localhost         → Caddy serves plain HTTP (dev mode).
# ============================================================

# ── API / sockets  (path-prefix routing) ─────────────────────────────────────
{$API_HOST} {
    # WebSocket upgrade for Socket.IO must reach the API container
    handle /socket.io/* {
        reverse_proxy gateway:3002
    }
    # REST API
    handle /api/* {
        reverse_proxy gateway:3002
    }   
}

# ── Web frontend on a separate domain ────────────────────────────────────────
{$WEB_HOST} {
    reverse_proxy console:3000
}

# ── Silo CDN  (cdn.example.com → silo:9001) ────────────────────────────────
# Caddy terminates TLS for the CDN subdomain and proxies to the Silo container
# on the internal Docker network.  No non-standard ports needed.
{$CDN_HOST} {
    reverse_proxy silo:9001 {
        # Set Host to internal address for Silo signature validation
        # Silo signs URLs with the host it knows (silo:9001), so we must
        # preserve that in the Host header, otherwise signatures fail
        header_up Host "silo:9001"
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
    
    # Allow larger file uploads (default is 10MB, increase to 100MB)
    request_body {
        max_size 100MB
    }
}

# ── Log Viewer (logs.example.com → log-viewer:8080) ──────────────────────────
{$LOG_HOST} {
    reverse_proxy log-viewer:8080
}
